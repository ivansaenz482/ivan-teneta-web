rules_version = '2';

// Reglas para Firebase Storage.
// PÉGALAS en Firebase Console -> Storage -> Rules
// Las imágenes se guardan en la carpeta "products". Se permite lectura pública
// (para que todos los visitantes las vean) y escritura para el panel admin.
// Para producción, limita la escritura con Firebase Auth.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
