rules_version = '2';

// Reglas para Firestore.
// PÉGALAS en Firebase Console -> Firestore Database -> Rules
// Este sitio estático usa escritura abierta para que el panel (con su contraseña)
// pueda guardar la tienda, las estadísticas y las imágenes (colección product_images)
// sin necesitar Firebase Auth ni el plan Blaze. Todo funciona gratis en Spark.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
